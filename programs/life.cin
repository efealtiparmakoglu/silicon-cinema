// Conway'in Yasam Oyunu — 96x54 torus.
fn modn(a, n) {
  let r = a % n;
  if (r < 0) {
    r = r + n;
  }
  return r;
}

fn idx(x, y) {
  return modn(x, 96) + modn(y, 54) * 96;
}

fn main() {
  rand($SEED);
  let n = 5184;
  let a = arr(n);
  let b = arr(n);
  let i = 0;
  while (i < n) {
    if (rand(0) % 100 < 24) {
      a[i] = 1;
    }
    i = i + 1;
  }
  let t = 0;
  while (t < $FRAMES) {
    flush();
    let y = 0;
    while (y < 54) {
      let x = 0;
      while (x < 96) {
        let k = 0;
        let dy = 0 - 1;
        while (dy <= 1) {
          let dx = 0 - 1;
          while (dx <= 1) {
            if (dx != 0 | dy != 0) {
              k = k + a[idx(x + dx, y + dy)];
            }
            dx = dx + 1;
          }
          dy = dy + 1;
        }
        let u = idx(x, y);
        let yasam = 0;
        if (a[u] == 1) {
          if (k == 2 | k == 3) {
            yasam = 1;
          }
        } else {
          if (k == 3) {
            yasam = 1;
          }
        }
        if (yasam == 1) {
          b[u] = 1;
        } else {
          b[u] = 0;
        }
        x = x + 1;
      }
      y = y + 1;
    }
    i = 0;
    while (i < n) {
      a[i] = b[i];
      if (a[i] == 1) {
        pixel(i % 96, i / 96, 2016);
      } else {
        pixel(i % 96, i / 96, 0);
      }
      i = i + 1;
    }
    t = t + 1;
  }
}
