// XOR doku tuneli: tkenle kayan klasik demoscene deseni.
fn main() {
  rand($SEED);
  let t = 0;
  while (t < $FRAMES) {
    flush();
    let y = 0;
    while (y < 72) {
      let x = 0;
      while (x < 128) {
        let v = (x + t) ^ (y + t * 2);
        v = v % 64;
        if (v < 0) {
          v = v + 64;
        }
        // palet: v -> ates tonlari
        let r = v * 4;
        if (r > 31) {
          r = 31;
        }
        let g = v * 2;
        if (g > 63) {
          g = 63;
        }
        let b = 16 - v / 4;
        if (b < 0) {
          b = 0;
        }
        pixel(x, y, r * 2048 + g * 32 + b);
        x = x + 1;
      }
      y = y + 1;
    }
    t = t + 1;
  }
}
